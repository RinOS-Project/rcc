class atomic_flag {
public:
    static constexpr bool is_always_lock_free = true;
    constexpr atomic_flag() noexcept : value_(0u) {}
    atomic_flag(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) = delete;

    bool test_and_set(memory_order order) noexcept {
        return __atomic_test_and_set(&value_, order);
    }
    bool test_and_set(memory_order order) volatile noexcept {
        return __atomic_test_and_set(&value_, order);
    }
    bool test_and_set() noexcept {
        return test_and_set(memory_order_seq_cst);
    }
    bool test_and_set() volatile noexcept {
        return __atomic_test_and_set(&value_, memory_order_seq_cst);
    }

    void clear(memory_order order) noexcept {
        __atomic_clear(&value_, order);
    }
    void clear(memory_order order) volatile noexcept {
        __atomic_clear(&value_, order);
    }
    void clear() noexcept { clear(memory_order_seq_cst); }
    void clear() volatile noexcept {
        __atomic_clear(&value_, memory_order_seq_cst);
    }

    bool test(memory_order order) const noexcept {
        return __atomic_load_n(&value_, order) != 0u;
    }
    bool test(memory_order order) const volatile noexcept {
        return __atomic_load_n(&value_, order) != 0u;
    }
    bool test() const noexcept { return test(memory_order_seq_cst); }
    bool test() const volatile noexcept {
        return __atomic_load_n(&value_, memory_order_seq_cst) != 0u;
    }

private:
    mutable unsigned char value_;
};

template<class T>
class __rcc_atomic_base : public __rcc_atomic_ops<T> {
public:
    using value_type = T;
    static constexpr bool is_always_lock_free =
        sizeof(T) == 1u || sizeof(T) == 2u ||
        sizeof(T) == 4u || sizeof(T) == 8u;

    constexpr __rcc_atomic_base() noexcept : value_(0) {}
    constexpr __rcc_atomic_base(T desired) noexcept : value_(desired) {}
    __rcc_atomic_base(const __rcc_atomic_base&) = delete;
    __rcc_atomic_base& operator=(const __rcc_atomic_base&) = delete;

    bool is_lock_free() const noexcept {
        return __atomic_is_lock_free(sizeof(T), &value_);
    }
    bool is_lock_free() const volatile noexcept {
        return __atomic_is_lock_free(sizeof(T), &value_);
    }

    void store(T desired, memory_order order) noexcept {
        this->store_impl(&value_, desired, order);
    }
    void store(T desired, memory_order order) volatile noexcept {
        this->store_impl(&value_, desired, order);
    }
    void store(T desired) noexcept {
        store(desired, memory_order_seq_cst);
    }
    void store(T desired) volatile noexcept {
        this->store_impl(&value_, desired, memory_order_seq_cst);
    }

    T load(memory_order order) const noexcept {
        return this->load_impl(&value_, order);
    }
    T load(memory_order order) const volatile noexcept {
        return this->load_impl(&value_, order);
    }
    T load() const noexcept { return load(memory_order_seq_cst); }
    T load() const volatile noexcept {
        return this->load_impl(&value_, memory_order_seq_cst);
    }

    operator T() const noexcept {
        return load(memory_order_seq_cst);
    }
    operator T() const volatile noexcept {
        return this->load_impl(&value_, memory_order_seq_cst);
    }

    T exchange(T desired, memory_order order) noexcept {
        return this->exchange_impl(&value_, desired, order);
    }
    T exchange(T desired, memory_order order) volatile noexcept {
        return this->exchange_impl(&value_, desired, order);
    }
    T exchange(T desired) noexcept {
        return exchange(desired, memory_order_seq_cst);
    }
    T exchange(T desired) volatile noexcept {
        return this->exchange_impl(&value_, desired,
                                   memory_order_seq_cst);
    }

    bool compare_exchange_weak(T& expected, T desired,
                               memory_order success,
                               memory_order failure) noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, true, success, failure);
    }
    bool compare_exchange_weak(T& expected, T desired,
                               memory_order success,
                               memory_order failure) volatile noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, true, success, failure);
    }

    bool compare_exchange_weak(T& expected, T desired) noexcept {
        return compare_exchange_weak(
            expected, desired, memory_order_seq_cst,
            memory_order_seq_cst);
    }
    bool compare_exchange_weak(T& expected, T desired) volatile noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, true, memory_order_seq_cst,
            memory_order_seq_cst);
    }

    bool compare_exchange_weak(T& expected, T desired,
                               memory_order order) noexcept {
        return compare_exchange_weak(
            expected, desired, order, default_failure_order(order));
    }
    bool compare_exchange_weak(T& expected, T desired,
                               memory_order order) volatile noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, true, order,
            default_failure_order(order));
    }

    bool compare_exchange_strong(T& expected, T desired,
                                 memory_order success,
                                 memory_order failure) noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, false, success, failure);
    }
    bool compare_exchange_strong(T& expected, T desired,
                                 memory_order success,
                                 memory_order failure) volatile noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, false, success, failure);
    }

    bool compare_exchange_strong(T& expected, T desired) noexcept {
        return compare_exchange_strong(
            expected, desired, memory_order_seq_cst,
            memory_order_seq_cst);
    }
    bool compare_exchange_strong(T& expected, T desired) volatile noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, false, memory_order_seq_cst,
            memory_order_seq_cst);
    }

    bool compare_exchange_strong(T& expected, T desired,
                                 memory_order order) noexcept {
        return compare_exchange_strong(
            expected, desired, order, default_failure_order(order));
    }
    bool compare_exchange_strong(T& expected, T desired,
                                 memory_order order) volatile noexcept {
        return this->compare_exchange_impl(
            &value_, &expected, desired, false, order,
            default_failure_order(order));
    }

protected:
    static memory_order default_failure_order(memory_order order) noexcept {
        if (order == memory_order_release) return memory_order_relaxed;
        if (order == memory_order_acq_rel) return memory_order_acquire;
        return order;
    }

    mutable volatile T value_;
};

template<class T>
class atomic : public __rcc_atomic_base<T> {
public:
    constexpr atomic() noexcept : __rcc_atomic_base<T>() {}
    constexpr atomic(T desired) noexcept : __rcc_atomic_base<T>(desired) {}
    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;

    T operator=(T desired) noexcept {
        this->store(desired, memory_order_seq_cst);
        return desired;
    }
    T operator=(T desired) volatile noexcept {
        this->store_impl(&this->value_, desired, memory_order_seq_cst);
        return desired;
    }

    T fetch_add(T operand, memory_order order) noexcept {
        return this->fetch_add_impl(&this->value_, operand, order);
    }
    T fetch_add(T operand, memory_order order) volatile noexcept {
        return this->fetch_add_impl(&this->value_, operand, order);
    }
    T fetch_add(T operand) noexcept {
        return fetch_add(operand, memory_order_seq_cst);
    }
    T fetch_add(T operand) volatile noexcept {
        return this->fetch_add_impl(
            &this->value_, operand, memory_order_seq_cst);
    }

    T fetch_sub(T operand, memory_order order) noexcept {
        return this->fetch_sub_impl(&this->value_, operand, order);
    }
    T fetch_sub(T operand, memory_order order) volatile noexcept {
        return this->fetch_sub_impl(&this->value_, operand, order);
    }
    T fetch_sub(T operand) noexcept {
        return fetch_sub(operand, memory_order_seq_cst);
    }
    T fetch_sub(T operand) volatile noexcept {
        return this->fetch_sub_impl(
            &this->value_, operand, memory_order_seq_cst);
    }

    template<class U = T>
    T fetch_and(T operand, memory_order order) noexcept {
        return __atomic_fetch_and(&this->value_, operand, order);
    }
    template<class U = T>
    T fetch_and(T operand, memory_order order) volatile noexcept {
        return __atomic_fetch_and(&this->value_, operand, order);
    }
    template<class U = T>
    T fetch_and(T operand) noexcept {
        return __atomic_fetch_and(
            &this->value_, operand, memory_order_seq_cst);
    }
    template<class U = T>
    T fetch_and(T operand) volatile noexcept {
        return __atomic_fetch_and(
            &this->value_, operand, memory_order_seq_cst);
    }

    template<class U = T>
    T fetch_or(T operand, memory_order order) noexcept {
        return __atomic_fetch_or(&this->value_, operand, order);
    }
    template<class U = T>
    T fetch_or(T operand, memory_order order) volatile noexcept {
        return __atomic_fetch_or(&this->value_, operand, order);
    }
    template<class U = T>
    T fetch_or(T operand) noexcept {
        return __atomic_fetch_or(
            &this->value_, operand, memory_order_seq_cst);
    }
    template<class U = T>
    T fetch_or(T operand) volatile noexcept {
        return __atomic_fetch_or(
            &this->value_, operand, memory_order_seq_cst);
    }

    template<class U = T>
    T fetch_xor(T operand, memory_order order) noexcept {
        return __atomic_fetch_xor(&this->value_, operand, order);
    }
    template<class U = T>
    T fetch_xor(T operand, memory_order order) volatile noexcept {
        return __atomic_fetch_xor(&this->value_, operand, order);
    }
    template<class U = T>
    T fetch_xor(T operand) noexcept {
        return __atomic_fetch_xor(
            &this->value_, operand, memory_order_seq_cst);
    }
    template<class U = T>
    T fetch_xor(T operand) volatile noexcept {
        return __atomic_fetch_xor(
            &this->value_, operand, memory_order_seq_cst);
    }

    template<class U = T>
    T operator&=(T operand) noexcept {
        return this->fetch_and(operand) & operand;
    }
    template<class U = T>
    T operator&=(T operand) volatile noexcept {
        return this->fetch_and(operand) & operand;
    }
    template<class U = T>
    T operator|=(T operand) noexcept {
        return this->fetch_or(operand) | operand;
    }
    template<class U = T>
    T operator|=(T operand) volatile noexcept {
        return this->fetch_or(operand) | operand;
    }
    template<class U = T>
    T operator^=(T operand) noexcept {
        return this->fetch_xor(operand) ^ operand;
    }
    template<class U = T>
    T operator^=(T operand) volatile noexcept {
        return this->fetch_xor(operand) ^ operand;
    }

    T operator++() noexcept { return fetch_add(1, memory_order_seq_cst) + 1; }
    T operator++() volatile noexcept {
        return this->fetch_add_impl(
            &this->value_, 1, memory_order_seq_cst) + 1;
    }
    T operator++(int) noexcept {
        return fetch_add(1, memory_order_seq_cst);
    }
    T operator++(int) volatile noexcept {
        return this->fetch_add_impl(
            &this->value_, 1, memory_order_seq_cst);
    }
    T operator--() noexcept { return fetch_sub(1, memory_order_seq_cst) - 1; }
    T operator--() volatile noexcept {
        return this->fetch_sub_impl(
            &this->value_, 1, memory_order_seq_cst) - 1;
    }
    T operator--(int) noexcept {
        return fetch_sub(1, memory_order_seq_cst);
    }
    T operator--(int) volatile noexcept {
        return this->fetch_sub_impl(
            &this->value_, 1, memory_order_seq_cst);
    }
    T operator+=(T operand) noexcept {
        return fetch_add(operand, memory_order_seq_cst) + operand;
    }
    T operator+=(T operand) volatile noexcept {
        return this->fetch_add_impl(
            &this->value_, operand, memory_order_seq_cst) + operand;
    }
    T operator-=(T operand) noexcept {
        return fetch_sub(operand, memory_order_seq_cst) - operand;
    }
    T operator-=(T operand) volatile noexcept {
        return this->fetch_sub_impl(
            &this->value_, operand, memory_order_seq_cst) - operand;
    }
};

template<class T>
class atomic<T*> : public __rcc_atomic_base<T*> {
public:
    using difference_type = ptrdiff_t;

    constexpr atomic() noexcept : __rcc_atomic_base<T*>() {}
    constexpr atomic(T* desired) noexcept
        : __rcc_atomic_base<T*>(desired) {}

    T* operator=(T* desired) noexcept {
        this->store(desired, memory_order_seq_cst);
        return desired;
    }
    T* operator=(T* desired) volatile noexcept {
        this->store_impl(&this->value_, desired, memory_order_seq_cst);
        return desired;
    }

    /* The builtin takes byte offsets; this API takes element offsets. */
    T* fetch_add(difference_type operand, memory_order order) noexcept {
        return __atomic_fetch_add(
            &this->value_, operand * sizeof(T), order);
    }
    T* fetch_add(difference_type operand,
                 memory_order order) volatile noexcept {
        return __atomic_fetch_add(
            &this->value_, operand * sizeof(T), order);
    }
    T* fetch_add(difference_type operand) noexcept {
        return fetch_add(operand, memory_order_seq_cst);
    }
    T* fetch_add(difference_type operand) volatile noexcept {
        return __atomic_fetch_add(
            &this->value_, operand * sizeof(T), memory_order_seq_cst);
    }

    T* fetch_sub(difference_type operand, memory_order order) noexcept {
        return __atomic_fetch_sub(
            &this->value_, operand * sizeof(T), order);
    }
    T* fetch_sub(difference_type operand,
                 memory_order order) volatile noexcept {
        return __atomic_fetch_sub(
            &this->value_, operand * sizeof(T), order);
    }
    T* fetch_sub(difference_type operand) noexcept {
        return fetch_sub(operand, memory_order_seq_cst);
    }
    T* fetch_sub(difference_type operand) volatile noexcept {
        return __atomic_fetch_sub(
            &this->value_, operand * sizeof(T), memory_order_seq_cst);
    }

    T* operator++() noexcept {
        return fetch_add(1, memory_order_seq_cst) + 1;
    }
    T* operator++() volatile noexcept {
        return __atomic_fetch_add(
            &this->value_, sizeof(T), memory_order_seq_cst) + 1;
    }
    T* operator++(int) noexcept {
        return fetch_add(1, memory_order_seq_cst);
    }
    T* operator++(int) volatile noexcept {
        return __atomic_fetch_add(
            &this->value_, sizeof(T), memory_order_seq_cst);
    }
    T* operator--() noexcept {
        return fetch_sub(1, memory_order_seq_cst) - 1;
    }
    T* operator--() volatile noexcept {
        return __atomic_fetch_sub(
            &this->value_, sizeof(T), memory_order_seq_cst) - 1;
    }
    T* operator--(int) noexcept {
        return fetch_sub(1, memory_order_seq_cst);
    }
    T* operator--(int) volatile noexcept {
        return __atomic_fetch_sub(
            &this->value_, sizeof(T), memory_order_seq_cst);
    }
    T* operator+=(difference_type operand) noexcept {
        return fetch_add(operand, memory_order_seq_cst) + operand;
    }
    T* operator+=(difference_type operand) volatile noexcept {
        return __atomic_fetch_add(
            &this->value_, operand * sizeof(T), memory_order_seq_cst) +
            operand;
    }
    T* operator-=(difference_type operand) noexcept {
        return fetch_sub(operand, memory_order_seq_cst) - operand;
    }
    T* operator-=(difference_type operand) volatile noexcept {
        return __atomic_fetch_sub(
            &this->value_, operand * sizeof(T), memory_order_seq_cst) -
            operand;
    }
};

