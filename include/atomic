    return object->is_lock_free();
}

template<class T>
void atomic_init(volatile atomic<T>* object, T desired) noexcept {
    object->store(desired, memory_order_relaxed);
}

template<class T>
T atomic_load(const volatile atomic<T>* object) noexcept {
    return object->load();
}
template<class T>
T atomic_load_explicit(const volatile atomic<T>* object,
                       memory_order order) noexcept {
    return object->load(order);
}

template<class T>
void atomic_store(volatile atomic<T>* object, T desired) noexcept {
    object->store(desired);
}
template<class T>
void atomic_store_explicit(volatile atomic<T>* object, T desired,
                           memory_order order) noexcept {
    object->store(desired, order);
}

