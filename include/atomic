#ifndef RCC_CXX_ATOMIC
#define RCC_CXX_ATOMIC

#include <stddef.h>

namespace std {

enum memory_order {
    memory_order_relaxed = __ATOMIC_RELAXED,
    memory_order_consume = __ATOMIC_CONSUME,
    memory_order_acquire = __ATOMIC_ACQUIRE,
    memory_order_release = __ATOMIC_RELEASE,
    memory_order_acq_rel = __ATOMIC_ACQ_REL,
    memory_order_seq_cst = __ATOMIC_SEQ_CST
};

inline void atomic_thread_fence(memory_order order) noexcept {
    __atomic_thread_fence(order);
}
inline void atomic_signal_fence(memory_order order) noexcept {
    __atomic_signal_fence(order);
}

template<class T>
T kill_dependency(T value) noexcept {
    return value;
}

template<class T>
struct __rcc_atomic_ops {
    static void store_impl(volatile T* object, T desired,
                           memory_order order) noexcept {
        __atomic_store_n(object, desired, order);
    }
    static T load_impl(const volatile T* object,
                       memory_order order) noexcept {
        return __atomic_load_n(object, order);
    }
    static T exchange_impl(volatile T* object, T desired,
                           memory_order order) noexcept {
        return __atomic_exchange_n(object, desired, order);
    }
    static bool compare_exchange_impl(
        volatile T* object, T* expected, T desired, bool weak,
        memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(
            object, expected, desired, weak, success, failure);
    }
    static T fetch_add_impl(volatile T* object, T operand,
                            memory_order order) noexcept {
        return __atomic_fetch_add(object, operand, order);
    }
    static T fetch_sub_impl(volatile T* object, T operand,
                            memory_order order) noexcept {
        return __atomic_fetch_sub(object, operand, order);
    }
};

template<class T>
struct __rcc_atomic_ops<T*> {
    static void store_impl(T* volatile* object, T* desired,
                           memory_order order) noexcept {
        __atomic_store_n(object, desired, order);
    }
    static T* load_impl(T* const volatile* object,
                        memory_order order) noexcept {
        return __atomic_load_n(object, order);
    }
    static T* exchange_impl(T* volatile* object, T* desired,
                            memory_order order) noexcept {
        return __atomic_exchange_n(object, desired, order);
    }
    static bool compare_exchange_impl(
        T* volatile* object, T** expected, T* desired, bool weak,
        memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(
            object, expected, desired, weak, success, failure);
    }
};

template<>
struct __rcc_atomic_ops<float> {
    static void store_impl(volatile float* object, float desired,
                           memory_order order) noexcept {
        __atomic_store(object, &desired, order);
    }
    static float load_impl(const volatile float* object,
                           memory_order order) noexcept {
        float result;
        __atomic_load(object, &result, order);
        return result;
    }
    static float exchange_impl(volatile float* object, float desired,
                               memory_order order) noexcept {
        float previous;
        __atomic_exchange(object, &desired, &previous, order);
        return previous;
    }
    static bool compare_exchange_impl(
        volatile float* object, float* expected, float desired, bool weak,
        memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange(
            object, expected, &desired, weak, success, failure);
    }
    static float fetch_add_impl(volatile float* object, float operand,
                                memory_order order) noexcept {
        float expected;
        __atomic_load(object, &expected, memory_order_relaxed);
        for (;;) {
            float desired = expected + operand;
            if (__atomic_compare_exchange(
                    object, &expected, &desired, 1, order,
                    memory_order_relaxed))
                return expected;
        }
    }
    static float fetch_sub_impl(volatile float* object, float operand,
                                memory_order order) noexcept {
        float expected;
        __atomic_load(object, &expected, memory_order_relaxed);
        for (;;) {
            float desired = expected - operand;
            if (__atomic_compare_exchange(
                    object, &expected, &desired, 1, order,
                    memory_order_relaxed))
                return expected;
        }
    }
};

